digraph PhantomThievesRoute {
  graph [rankdir=LR, splines=ortho, nodesep=0.45, ranksep=0.8, bgcolor="white", pad=0.25, label="Phantom Thieves Route — ERD Overview", labelloc=t, fontsize=20, fontname="Arial"];
  node [shape=record, style="rounded,filled", fillcolor="#f7f8fc", color="#4c5a78", fontname="Arial", fontsize=10, margin="0.12,0.08"];
  edge [color="#53627c", arrowsize=0.7, fontname="Arial", fontsize=9];
  game_dates [label="{game_dates|PK game_date_id\l game_date\l weekday\l}"];
  activities [label="{activities|PK activity_id\l activity_name\l category\l}"];
  calendar_activities [label="{calendar_activities|PK calendar_activity_id\l FK game_date_id\l FK activity_id\l session\l stat gains\l}"];
  player_profiles [label="{player_profiles|PK player_id\l FK current_game_date_id\l social stats\l}"];
  confidants [label="{confidants|PK confidant_id\l confidant_name\l arcana\l}"];
  player_confidant_ranks [label="{player_confidant_ranks|PK/FK player_id\l PK/FK confidant_id\l current_rank\l}"];
  confidant_interactions [label="{confidant_interactions|PK interaction_id\l FK confidant_id\l rank_target\l answer_text\l}"];
  qa_entries [label="{qa_entries|PK qa_id\l FK game_date_id\l question_type\l answer_text\l}"];
  personas [label="{personas|PK persona_id\l persona_name\l level\l}"];
  fusion_recipes [label="{fusion_recipes|PK recipe_id\l FK target_persona_id\l}"];
  fusion_recipe_materials [label="{fusion_recipe_materials|PK/FK recipe_id\l PK material_slot\l FK persona_id\l}"];
  bosses [label="{bosses|PK boss_id\l FK first/last date IDs\l is_optional, is_spoiler\l}"];
  boss_affinities [label="{boss_affinities|PK affinity_id\l FK boss_id\l element, affinity_type\l}"];
  party_members [label="{party_members|PK party_member_id\l member_name\l}"];
  recommended_party_members [label="{recommended_party_members|PK/FK boss_id\l PK/FK party_member_id\l}"];
  game_dates -> calendar_activities [label="1:N"];
  activities -> calendar_activities [label="1:N"];
  game_dates -> player_profiles [label="1:N"];
  game_dates -> qa_entries [label="1:N"];
  player_profiles -> player_confidant_ranks [label="1:N"];
  confidants -> player_confidant_ranks [label="1:N"];
  confidants -> confidant_interactions [label="1:N"];
  personas -> fusion_recipes [label="1:N target"];
  fusion_recipes -> fusion_recipe_materials [label="1:N"];
  personas -> fusion_recipe_materials [label="1:N material"];
  game_dates -> bosses [label="availability"];
  bosses -> boss_affinities [label="1:N"];
  bosses -> recommended_party_members [label="1:N"];
  party_members -> recommended_party_members [label="1:N"];
}
